APIFY_API_TOKEN=your_apify_api_token_here

# AI Verifier (Gemini Flash) — enables the semantic precision backstop.
# Get a key at https://aistudio.google.com/apikey
# Leave blank to run regex-only (verifier auto-skips when no key is set).
GOOGLE_API_KEY=your_google_api_key_here

# Optional verifier tuning (defaults shown):
# VERIFIER_ENABLED=true
# VERIFIER_MODEL=gemini-flash-latest
# VERIFIER_BATCH_SIZE=20
# VERIFIER_MIN_CONFIDENCE=60
# VERIFIER_MAX_POSTS=400

# ── Multi-source lead collection (agent/collectors/, config/sources.py) ──────
# All sources use APIFY_API_TOKEN except Freelancer.com (free public API).
# Comma-separated; leave unset to scan every source. Keys:
#   linkedin_post, linkedin_job, meta_ads, upwork, freelancer, x_post,
#   product_hunt, funding_news
# LEAD_SOURCES=linkedin_post,linkedin_job,meta_ads,upwork,freelancer,x_post,product_hunt,funding_news

# Apollo enriches the top-N leads by score per scan (caps credit use).
# APOLLO_MAX_LEADS=200

# Hard cap on Apify spend per scan (USD). Split across sources by
# config/sources.py BUDGET_SHARES; every actor run gets a maxItems cap.
# SCAN_BUDGET_USD=5

# ── Key contacts (dashboard "👥 Key Contacts", agent/contacts.py) ────────────
# Apollo People Search (free) finds CEO/COO/CMO/Head of Marketing; when it finds
# fewer than 2, an Apify LinkedIn-employees run fills in (~$0.003/profile).
# "Reveal" spends 1 Apollo credit for a verified email. Mobile numbers are sent
# by Apollo to a webhook, so they only work on a public URL (Render sets
# RENDER_EXTERNAL_URL automatically; set PUBLIC_BASE_URL anywhere else).
# PUBLIC_BASE_URL=https://your-dashboard.onrender.com
# CONTACTS_APIFY_ACTOR=harvestapi~linkedin-company-employees
# CONTACTS_APIFY_MAX_PROFILES=15
